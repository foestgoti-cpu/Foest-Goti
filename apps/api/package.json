{
  "name": "@foest/api",
  "version": "0.1.0",
  "private": true,
  "description": "API de negocio FOEST (Express + TypeScript, CommonJS) sobre Supabase",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-plantillas.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "lint": "tsc -p tsconfig.json --noEmit",
    "seed:admin": "tsx --env-file-if-exists=.env scripts/seed-admin.ts",
    "verify:supabase": "tsx --env-file-if-exists=.env scripts/verify-supabase.ts",
    "festivos:seed": "tsx --env-file-if-exists=.env scripts/seed-festivos.ts",
    "snies:import": "tsx --env-file-if-exists=.env scripts/import-snies.ts"
  },
  "dependencies": {
    "@foest/shared": "*",
    "@supabase/supabase-js": "^2.45.6",
    "cors": "^2.8.5",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "handlebars": "^4.7.10",
    "helmet": "^8.0.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.0.15",
    "pdf-lib": "^1.17.1",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "puppeteer": "^25.12.0",
    "qrcode": "^1.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@istanbuljs/load-nyc-config": "^1.1.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.9.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.2",
    "jest": "^30.5.2",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.14",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
