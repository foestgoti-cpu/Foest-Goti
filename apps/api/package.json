{
  "name": "@foest/api",
  "version": "0.1.0",
  "private": true,
  "description": "API de negocio FOEST (Express + TypeScript, CommonJS) sobre Supabase",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "lint": "tsc -p tsconfig.json --noEmit",
    "seed:admin": "tsx --env-file-if-exists=.env scripts/seed-admin.ts",
    "verify:supabase": "tsx --env-file-if-exists=.env scripts/verify-supabase.ts"
  },
  "dependencies": {
    "@foest/shared": "*",
    "@supabase/supabase-js": "^2.45.6",
    "cors": "^2.8.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "node-cron": "^4.6.0",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.9.0",
    "@types/node-cron": "^3.0.11",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
