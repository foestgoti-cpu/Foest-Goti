# apps/api/.env  (copiar desde este archivo; no se sube al repositorio)

# Supabase - Project Settings -> API
SUPABASE_URL=https://kixjejmewgynzrppowfv.supabase.co
SUPABASE_ANON_KEY=
# Service role: SOLO en el servidor. Nunca en apps/web ni en el navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Servidor HTTP
PORT=4000
# Origen permitido para CORS con credenciales (la SPA de Vite en desarrollo)
WEB_ORIGIN=http://localhost:5173
# trace | debug | info | warn | error
LOG_LEVEL=info
NODE_ENV=development

# Rate limit basico (ventana en ms y maximo de peticiones por IP)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Postulaciones: clave AES-256-GCM (32 bytes en hex de 64 caracteres) para cifrar los datos de pago del ST.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATOS_PAGO_KEY=
DATOS_PAGO_KEY_VERSION=v1

# Semilla del primer administrador: npm run seed:admin -w apps/api
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Notificaciones: correo saliente (modulo notificaciones). Sin SMTP_HOST los correos se escriben en el log (ConsoleMailer).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Remitente de todos los correos (firmados "Equipo FOEST")
MAIL_FROM=Equipo FOEST <no-responder@tocancipa.gov.co>
# Secreto HMAC-SHA256 (min. 16 caracteres) del webhook POST /api/v1/notificaciones/webhooks/correo (rebotes y quejas).
# Vacio = webhook deshabilitado (responde 404). Cabecera esperada: X-Foest-Firma: t=<unix>,v1=<hmac(t + "." + json canonico)>
MAIL_WEBHOOK_SECRET=
