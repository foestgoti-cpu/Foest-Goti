{
  "name": "@foest/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Enums, esquemas Zod y tipos compartidos entre apps/api y apps/web",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "node ./scripts/clean.cjs",
    "build": "npm run clean && tsc -p tsconfig.cjs.json && tsc -p tsconfig.esm.json && node ./scripts/postbuild.cjs",
    "typecheck": "tsc -p tsconfig.esm.json --noEmit",
    "test": "jest --passWithNoTests",
    "lint": "tsc -p tsconfig.esm.json --noEmit"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.14",
    "typescript": "^5.6.3"
  }
}
