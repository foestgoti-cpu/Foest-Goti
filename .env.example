# Variables de entorno de referencia para la raiz del monorepo.
# Copie este archivo a .env (nunca se sube al repositorio).
# Los valores reales los provee el administrador del proyecto Supabase:
# https://kixjejmewgynzrppowfv.supabase.co  ->  Project Settings  ->  API

# --- Supabase (compartidas por api y web) ---
SUPABASE_URL=https://kixjejmewgynzrppowfv.supabase.co
SUPABASE_ANON_KEY=

# --- Solo API (nunca exponer al navegador) ---
SUPABASE_SERVICE_ROLE_KEY=

# --- API ---
PORT=4000
WEB_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# --- Semilla del primer administrador (scripts/seed-admin.ts) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=
